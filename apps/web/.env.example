# Server-only variables. Never prefix these with NEXT_PUBLIC_.
CORE_INTERNAL_URL=http://127.0.0.1:8080
WEB_ORIGIN=http://localhost:3000
# Production: CORE_INTERNAL_URL must be the HTTPS URL reachable from Vercel,
# e.g. https://core.example.org (replace with your own domain).
# WEB_ORIGIN is the exact public web origin; no trailing slash or path.
