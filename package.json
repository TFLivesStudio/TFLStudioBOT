{
  "name": "tfl-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter \"@tfl/core\" --filter \"@tfl/web\" dev",
    "dev:core": "bun run --filter @tfl/core dev",
    "dev:web": "bun run --filter @tfl/web dev",
    "start": "bun run --filter @tfl/core start",
    "migrate": "bun packages/database/src/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json && bun run --filter \"*\" typecheck",
    "lint": "eslint .",
    "test": "bun scripts/test.ts",
    "test:e2e": "playwright test",
    "build": "bun run --filter \"*\" build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "test:integration": "bun scripts/integration.ts",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.mjs .github/workflows/*.yml",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts *.mjs .github/workflows/*.yml"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/bun": "1.4.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
